# lmWorld Backend Configuration Example
# Copy this file to .env for local development if you need to override defaults.

APP_NAME=lmWorld
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./lmworld.db

# Ollama servers
OLLAMA_GPU_HOST=http://localhost:11434
OLLAMA_CPU_HOST=http://localhost:11435

# Hugging Face
# Optional. You can also set this in the app UI under Settings/Hire Agent.
HF_TOKEN=
MODELS_DIR=../models

# Resource limits
MAX_RAM_USAGE_PERCENT=80.0
MAX_VRAM_USAGE_PERCENT=90.0
